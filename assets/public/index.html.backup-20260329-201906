  <script>
    // Current spread selection
    let currentSpread = 3;
    
    // Spread definitions
    const SPREADS = {
      1: {
        name: 'Single Card',
        positions: [
          { name: 'Your Guidance', guide: 'The message for you right now' }
        ],
        description: 'A single card drawn for quick guidance. Perfect for daily reflection or a simple yes/no question.'
      },
      3: {
        name: 'Three-Card Spread',
        positions: [
          { name: 'The Situation', guide: 'Where you are right now' },
          { name: 'The Choice', guide: 'The decision before you' },
          { name: 'The Outcome', guide: 'Where this path leads' }
        ],
        description: 'Perfect for understanding a decision. The cards represent: The Situation, The Choice, and The Outcome.'
      },
      7: {
        name: 'Celtic Cross',
        positions: [
          { name: 'Present', guide: 'Your current situation' },
          { name: 'Challenge', guide: 'The obstacle you face' },
          { name: 'Goal', guide: 'Your conscious aim' },
          { name: 'Foundation', guide: 'Root of the matter' },
          { name: 'Past', guide: 'Recent influences' },
          { name: 'Future', guide: 'What lies ahead' },
          { name: 'Outcome', guide: 'Final resolution' }
        ],
        description: 'A powerful spread for deep insight. Explores your present situation, challenges, goals, influences, and potential outcomes.'
      }
    };
    
    // Generate animated starfield background
    function createStars() {
      const starsContainer = document.getElementById('stars');
      const starCount = 60;
      
      for (let i = 0; i < starCount; i++) {
        const star = document.createElement('div');
        star.className = 'star';
        star.style.left = Math.random() * 100 + '%';
        star.style.top = Math.random() * 100 + '%';
        const size = Math.random() * 2 + 1;
        star.style.width = size + 'px';
        star.style.height = size + 'px';
        star.style.animationDelay = (Math.random() * 2) + 's';
        starsContainer.appendChild(star);
      }
    }
    
    createStars();
    
    // Select spread type
    function selectSpread(num) {
      currentSpread = num;
      
      // Update button states
      document.querySelectorAll('.spread-btn').forEach(btn => {
        btn.classList.remove('active');
        if (parseInt(btn.dataset.spread) === num) {
          btn.classList.add('active');
        }
      });
      
      // Update info box
      const spread = SPREADS[num];
      document.getElementById('spread-info').innerHTML = `
        <h3>${spread.name}</h3>
        <p>${spread.description}</p>
      `;
    }
    
    const API_BASE = 'https://tarotapi.dev/api/v1';
    
    // Map API card names to image filenames
    function getImageFilename(card) {
      const nameShort = card.name_short;
      
      // Major Arcana
      if (card.type === 'major') {
        const majorNames = {
          'ar00': 'fool', 'ar01': 'magician', 'ar02': 'priestess',
          'ar03': 'empress', 'ar04': 'emperor', 'ar05': 'hierophant',
          'ar06': 'lovers', 'ar07': 'chariot', 'ar08': 'strength',
          'ar09': 'hermit', 'ar10': 'fortune', 'ar11': 'justice',
          'ar12': 'hanged', 'ar13': 'death', 'ar14': 'temperance',
          'ar15': 'devil', 'ar16': 'tower', 'ar17': 'star',
          'ar18': 'moon', 'ar19': 'sun', 'ar20': 'judgement',
          'ar21': 'world'
        };
        const name = majorNames[nameShort];
        return name ? `major_arcana_${name}.jpg` : null;
      }
      
      // Minor Arcana
      if (card.type === 'minor') {
        const suitMap = {
          'cups': 'cups', 'swords': 'swords',
          'wands': 'wands', 'pentacles': 'pentacles'
        };
        
        const valueMap = {
          'ace': 'ace', 'two': '2', '2': '2', 'three': '3', '3': '3',
          'four': '4', '4': '4', 'five': '5', '5': '5', 'six': '6', '6': '6',
          'seven': '7', '7': '7', 'eight': '8', '8': '8', 'nine': '9', '9': '9',
          'ten': '10', '10': '10', 'page': 'page', 'knight': 'knight',
          'queen': 'queen', 'king': 'king'
        };
        
        const suit = suitMap[card.suit];
        const value = valueMap[card.value];
        
        if (suit && value) {
          return `minor_arcana_${suit}_${value}.jpg`;
        }
      }
      
      return null;
    }
    
    // Show custom question field
    document.getElementById('decision-type').addEventListener('change', (e) => {
      document.getElementById('custom-question').style.display = 
        e.target.value === 'custom' ? 'block' : 'none';
    });
    
    async function drawCards() {
      const decisionType = document.getElementById('decision-type').value;
      const customText = document.getElementById('custom-text').value;
      const name = document.getElementById('name').value;
      const errorEl = document.getElementById('error-msg');
      const loadingEl = document.getElementById('loading');
      const questionForm = document.getElementById('question-form');
      
      if (!decisionType) {
        errorEl.textContent = 'Please select a decision category';
        errorEl.classList.add('active');
        return;
      }
      
      if (decisionType === 'custom' && !customText.trim()) {
        errorEl.textContent = 'Please enter your question';
        errorEl.classList.add('active');
        return;
      }
      
      errorEl.classList.remove('active');
      questionForm.style.display = 'none';
      loadingEl.classList.add('active');
      
      try {
        // Draw cards based on spread
        const numCards = currentSpread;
        const response = await fetch(`${API_BASE}/cards/random?n=${numCards}`);
        const data = await response.json();
        
        if (!data || !data.cards || data.cards.length < numCards) {
          throw new Error('Failed to draw cards');
        }
        
        const cards = data.cards.slice(0, numCards);
        
        // Build question context
        const question = decisionType === 'custom' 
          ? customText 
          : `Should I move forward with this ${decisionType} decision?`;
        
        // Determine upright/reversed (API doesn't provide, so we randomize)
        // Higher reversal chance for Celtic Cross (more nuanced reading)
        const reversalChance = currentSpread === 7 ? 0.35 : 0.25;
        const cardsWithOrientation = cards.map(card => ({
          ...card,
          orientation: Math.random() < reversalChance ? 'reversed' : 'upright'
        }));
        
        // Generate reading
        const reading = getReading(cardsWithOrientation, question, name || 'seeker');
        
        // Display results
        displayReading(cardsWithOrientation, question, name, reading);
        
      } catch (err) {
        errorEl.textContent = `Error: ${err.message}`;
        errorEl.classList.add('active');
        questionForm.style.display = 'block';
      } finally {
        loadingEl.classList.remove('active');
      }
    }
    
    function getReading(cards, question, name) {
      const positions = SPREADS[cards.length].positions;
      
      let reading = `<div style="margin-bottom: 20px;">`;
      reading += `<strong>${name ? name + ', ' : 'Seeker, '}</strong>your ${SPREADS[cards.length].name} on: <em>"${question}"</em>`;
      reading += `</div>`;
      
      // Card interpretations
      cards.forEach((card, i) => {
        const pos = positions[i];
        const cardName = card.name || card.name_short.replace(/_/g, ' ');
        const isReversed = card.orientation === 'reversed';
        const meaning = isReversed ? card.meaning_rev : card.meaning_up;
        
        reading += `<div class="card-interpretation">`;
        reading += `<div style="color: #d4af37; font-size: 1.05em; margin-bottom: 4px;"><strong>${pos.name}:</strong> ${cardName}`;
        if (isReversed) reading += ` <span style="font-size: 0.8em;">(Reversed)</span>`;
        reading += `</div>`;
        reading += `<div style="font-size: 0.85em; opacity: 0.7; margin-bottom: 8px;">${pos.guide}</div>`;
        reading += `<div>${meaning}</div>`;
        
        // Position-specific guidance for reversals
        if (isReversed && currentSpread !== 1) {
          reading += `<div style="margin-top: 8px; font-style: italic; opacity: 0.85;">`;
          if (i === 0) {
            reading += `This reversal suggests blocked energy or resistance in your current situation.`;
          } else if (i === cards.length - 1) {
            reading += `The outcome is not fixed—consider adjusting your approach.`;
          } else {
            reading += `Consider what needs to be released or reexamined here.`;
          }
          reading += `</div>`;
        }
        
        reading += `</div>`;
      });
      
      // Synthesis
      const reversedCount = cards.filter(c => c.orientation === 'reversed').length;
      const majorCount = cards.filter(c => c.type === 'major').length;
      
      reading += `<div class="synthesis">`;
      reading += `<div style="color: #d4af37; font-size: 1.1em; margin-bottom: 10px;">Reading Summary</div>`;
      
      // Energy assessment
      if (reversedCount === 0) {
        reading += `<p><strong>Energy flows smoothly.</strong> All upright cards suggest clarity and forward momentum.</p>`;
      } else if (reversedCount === 1) {
        reading += `<p><strong>A pause point.</strong> One reversed card suggests something to reconsider.</p>`;
      } else if (reversedCount === 2) {
        reading += `<p><strong>Internal tension.</strong> Two reversed cards indicate conflicting energies to resolve.</p>`;
      } else {
        reading += `<p><strong>Time for reflection.</strong> Multiple reversals invite you to pause before acting.</p>`;
      }
      
      // Major arcana insight
      if (majorCount >= Math.ceil(cards.length / 2)) {
        reading += `<p><strong>Significant moment.</strong> Major Arcana cards speak of life themes and soul lessons.</p>`;
      } else {
        reading += `<p><strong>Practical guidance.</strong> Minor Arcana guide day-to-day choices and actions.</p>`;
      }
      
      reading += `<p style="margin-top: 10px;"><strong>Remember:</strong> Tarot illuminates your present—it does not predict your future. Trust your intuition.</p>`;
      reading += `</div>`;
      
      return reading;
    }
    
    function displayReading(cards, question, name, reading) {
      const spread = SPREADS[cards.length];
      const positions = spread.positions;
      
      // Update title
      document.getElementById('reading-title').style.color = '#d4af37';
      document.getElementById('reading-title').textContent = `Your ${spread.name}`;
      
      const intro = name 
        ? `${name}'s reading about: "${question}"`
        : `Reading about: "${question}"`;
      
      document.getElementById('reading-header').textContent = intro;
      
      // Build cards container
      const container = document.getElementById('cards-container');
      container.className = `cards-container spread-${cards.length}`;
      container.innerHTML = '';
      
      cards.forEach((card, i) => {
        const cardNum = i + 1;
        const displayName = card.name || card.name_short.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
        
        const slot = document.createElement('div');
        slot.className = 'card-slot';
        slot.innerHTML = `
          <div class="position">${positions[i].name}</div>
          <div class="card-back" id="card${cardNum}-back">
            <div class="card-back-symbol">◆</div>
            <div class="card-back-text">Decision Tarot</div>
          </div>
          <img class="card-image" id="card${cardNum}-image" src="" alt="" style="display:none;">
          <div class="card-name" id="card${cardNum}-name"></div>
          <div class="orientation" id="card${cardNum}-orientation"></div>
        `;
        
        container.appendChild(slot);
        
        // Set card data
        slot.querySelector('.card-name').textContent = displayName;
        slot.querySelector('.orientation').textContent = card.orientation === 'reversed' ? 'Reversed' : 'Upright';
      });
      
      document.getElementById('ai-reading').innerHTML = reading;
      document.getElementById('reading-area').classList.add('active');
      
      // Save to history (pass cards data)
      saveReading(question, cards, spread, reading);
    }
    
    function displayReading(cards, question, name, reading) {
      const positions = SPREADS[cards.length].positions;
      
      // Update title
      document.getElementById('reading-title').style.color = '#d4af37';
      document.getElementById('reading-title').textContent = `Your ${SPREADS[cards.length].name}`;
      
      const intro = name ? `${name}, your ${SPREADS[cards.length].name} on: "${question}"` : `Seeker, your ${SPREADS[cards.length].name} on: "${question}"`;
      document.getElementById('reading-header').textContent = intro;
      
      // Build cards container
      const container = document.getElementById('cards-container');
      container.className = `cards-container spread-${cards.length}`;
      container.innerHTML = '';
      
      cards.forEach((card, i) => {
        const cardNum = i + 1;
        const displayName = card.name || card.name_short.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
        
        const slot = document.createElement('div');
        slot.className = 'card-slot';
        slot.innerHTML = `
          <div class="position">${positions[i].name}</div>
          <div class="card-back" id="card${cardNum}-back">
            <div class="card-back-symbol">◆</div>
            <div class="card-back-text">Decision Tarot</div>
          </div>
          <img class="card-image" id="card${cardNum}-image" src="" alt="" style="display:none;">
          <div class="card-name" id="card${cardNum}-name"></div>
          <div class="orientation" id="card${cardNum}-orientation"></div>
        `;
        
        container.appendChild(slot);
        
        // Set card data
        slot.querySelector('.card-name').textContent = displayName;
        slot.querySelector('.orientation').textContent = card.orientation === 'reversed' ? 'Reversed' : 'Upright';
      });
      
      document.getElementById('ai-reading').innerHTML = reading;
      document.getElementById('reading-area').classList.add('active');
      
      // Animate card reveals with staggered timing
      cards.forEach((card, i) => {
        const cardNum = i + 1;
        const slot = container.children[i];
        const imageEl = slot.querySelector(`#card${cardNum}-image`);
        const backEl = slot.querySelector(`#card${cardNum}-back`);
        const displayName = card.name || card.name_short.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
        
        setTimeout(() => {
          const imageFilename = getImageFilename(card);
          if (imageFilename) {
            const preloadImg = new Image();
            preloadImg.onload = () => {
              // Hide card back, show image
              backEl.style.display = 'none';
              imageEl.src = `cards/${imageFilename}`;
              imageEl.alt = displayName;
              imageEl.style.display = 'block';
              imageEl.classList.add('revealed');
            };
            preloadImg.onerror = () => {
              backEl.style.display = 'none';
              imageEl.style.display = 'block';
              imageEl.classList.add('revealed');
            };
            preloadImg.src = `cards/${imageFilename}`;
          }
        }, 600 * (cardNum + 1)); // Stagger reveals
      });
    }
    
    function resetReading() {
      document.getElementById('reading-area').classList.remove('active');
      document.getElementById('question-form').style.display = 'block';
      document.getElementById('decision-type').value = '';
      document.getElementById('custom-text').value = '';
      document.getElementById('name').value = '';
    }
    
    // ========== TAB NAVIGATION ==========
    function switchTab(tabName) {
      // Update tab buttons
      document.querySelectorAll('.nav-tab').forEach(tab => {
        tab.classList.remove('active');
        if (tab.textContent.toLowerCase().includes(tabName)) {
          tab.classList.add('active');
        }
      });
      
      // Update tab content
      document.querySelectorAll('.tab-content').forEach(content => {
        content.classList.remove('active');
      });
      document.getElementById(`tab-${tabName}`).classList.add('active');
      
      // Load content for specific tabs
      if (tabName === 'daily') loadDailyCard();
      if (tabName === 'encyclopedia') loadEncyclopedia();
      if (tabName === 'history') loadHistory();
    }
    
    // ========== DAILY CARD ==========
    let dailyCardData = null;
    
    async function loadDailyCard() {
      const container = document.getElementById('daily-card-container');
      
      // Check if we have a cached daily card for today
      const today = new Date().toDateString();
      const cachedDaily = localStorage.getItem('dailyCard');
      
      if (cachedDaily) {
        const parsed = JSON.parse(cachedDaily);
        if (parsed.date === today) {
          dailyCardData = parsed.card;
          displayDailyCard(dailyCardData);
          return;
        }
      }
      
      // Fetch new daily card
      try {
        const response = await fetch(`${API_BASE}/cards/random?n=1`);
        const data = await response.json();
        const card = data.cards[0];
        
        dailyCardData = {
          ...card,
          orientation: Math.random() < 0.25 ? 'reversed' : 'upright'
        };
        
        // Cache for today
        localStorage.setItem('dailyCard', JSON.stringify({
          date: today,
          card: dailyCardData
        }));
        
        displayDailyCard(dailyCardData);
      } catch (err) {
        container.innerHTML = `
          <div class="history-empty">
            <div class="history-empty-icon">🔮</div>
            <p>Unable to draw daily card. Please check your connection.</p>
          </div>
        `;
      }
    }
    
    function displayDailyCard(card) {
      const container = document.getElementById('daily-card-container');
      const imageFilename = getImageFilename(card);
      const isReversed = card.orientation === 'reversed';
      const meaning = isReversed ? card.meaning_rev : card.meaning_up;
      const cardName = card.name || card.name_short.replace(/_/g, ' ');
      
      container.innerHTML = `
        <div class="daily-card-display">
          <img class="daily-card-image" src="cards/${imageFilename}" alt="${cardName}" style="${isReversed ? 'transform: rotate(180deg);' : ''}">
          <div class="daily-card-name">${cardName}${isReversed ? ' (Reversed)' : ''}</div>
          <div class="daily-card-meaning">${meaning}</div>
          <div class="daily-timestamp">Drawn today, ${new Date().toLocaleDateString()}</div>
        </div>
        <button onclick="drawNewDailyCard()" style="margin-top: 15px; padding: 10px 20px; background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%); color: #eee; border: 1px solid rgba(255,255,255,0.2); border-radius: 8px; cursor: pointer; font-family: 'Quicksand', sans-serif;">
          Draw New Card Tomorrow
        </button>
      `;
    }
    
    function drawNewDailyCard() {
      localStorage.removeItem('dailyCard');
      loadDailyCard();
    }
    
    // ========== ENCYCLOPEDIA ==========
    let allCards = [];
    
    async function loadEncyclopedia() {
      const grid = document.getElementById('encyclopedia-grid');
      
      if (allCards.length === 0) {
        try {
          const response = await fetch(`${API_BASE}/cards`);
          const data = await response.json();
          allCards = data.cards || data;
        } catch (err) {
          grid.innerHTML = '<p style="opacity:0.7;text-align:center;">Unable to load cards. Please check your connection.</p>';
          return;
        }
      }
      
      displayEncyclopediaCards(allCards);
    }
    
    function displayEncyclopediaCards(cards) {
      const grid = document.getElementById('encyclopedia-grid');
      
      grid.innerHTML = cards.map((card, index) => {
        const name = card.name || card.name_short.replace(/_/g, ' ');
        const imageFilename = getImageFilename(card);
        return `
          <div class="encyclopedia-card" data-card-index="${index}" onclick="showCardByIndex(${index})">
            <img src="cards/${imageFilename}" alt="${name}" onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 60 100%22><rect fill=%22%231a1a3e%22 width=%22100%%22 height=%22100%%22/><text x=%2230%22 y=%2255%22 text-anchor=%22middle%22 fill=%22%23d4af37%22 font-size=%2212%22>${name.substring(0,8)}</text></svg>'">
            <div class="card-title">${name.length > 15 ? name.substring(0, 12) + '...' : name}</div>
          </div>
        `;
      }).join('');
    }
    
    function showCardByIndex(index) {
      const card = allCards[index];
      if (card) {
        showCardDetail(card);
      }
    }
    
    function filterEncyclopedia() {
      const search = document.getElementById('encyclopedia-search').value.toLowerCase();
      const filtered = allCards.filter(card => {
        const name = (card.name || card.name_short).toLowerCase();
        const meaning = (card.meaning_up || '').toLowerCase();
        return name.includes(search) || meaning.includes(search);
      });
      displayEncyclopediaCards(filtered);
    }
    
    function showCardDetail(card) {
      const modal = document.getElementById('card-modal');
      const imageFilename = getImageFilename(card);
      const name = card.name || card.name_short.replace(/_/g, ' ');
      
      document.getElementById('modal-image').src = `cards/${imageFilename}`;
      document.getElementById('modal-name').textContent = name;
      document.getElementById('modal-upright').textContent = card.meaning_up || 'Upright meaning not available.';
      document.getElementById('modal-reversed').textContent = card.meaning_rev || 'Reversed meaning not available.';
      
      // Keywords - use desc excerpt if no keywords field
      const keywords = card.keywords ? card.keywords.join(', ') : extractKeywords(card.desc || card.meaning_up);
      document.getElementById('modal-keywords').textContent = keywords;
      
      modal.classList.add('active');
    }
    
    function extractKeywords(text) {
      if (!text) return 'No keywords available.';
      // Extract first few significant words
      const words = text.split(/[,.;]/)[0].split(' ').filter(w => w.length > 3).slice(0, 5);
      return words.length > 0 ? words.join(', ') : 'No keywords available.';
    }
    
    function closeModal(event) {
      // Close on overlay click or button click
      if (!event || event.target.classList.contains('modal-overlay') || event.target.classList.contains('modal-close')) {
        document.getElementById('card-modal').classList.remove('active');
      }
    }
    
    // ========== HISTORY ==========
    function loadHistory() {
      const container = document.getElementById('history-list');
      const history = JSON.parse(localStorage.getItem('readingHistory') || '[]');
      
      if (history.length === 0) {
        container.innerHTML = `
          <div class="history-empty">
            <div class="history-empty-icon">📖</div>
            <p>No readings yet. Your reading history will appear here.</p>
          </div>
        `;
        return;
      }
      
      container.innerHTML = history.map((reading, index) => `
        <div class="history-item" onclick='showHistoryReading(${index})'>
          <div class="history-date">${new Date(reading.timestamp).toLocaleDateString()} · ${reading.spread}</div>
          <div class="history-question">${reading.question}</div>
          <div class="history-cards">${reading.cards.map(c => c.name + (c.orientation === 'reversed' ? ' ↺' : '')).join(' → ')}</div>
        </div>
      `).join('');
    }
    
    function showHistoryReading(index) {
      const history = JSON.parse(localStorage.getItem('readingHistory') || '[]');
      const reading = history[index];
      
      if (!reading) return;
      
      // Build a display similar to the reading area
      const container = document.getElementById('cards-container');
      container.className = `cards-container spread-${reading.cards.length}`;
      container.innerHTML = '';
      
      reading.cards.forEach((card, i) => {
        const positions = SPREADS[reading.cards.length].positions;
        const imageFilename = getImageFilename(card);
        const isReversed = card.orientation === 'reversed';
        
        const slot = document.createElement('div');
        slot.className = 'card-slot';
        slot.innerHTML = `
          <div class="position">${positions[i].name}</div>
          <img class="card-image" src="cards/${imageFilename}" alt="${card.name}" style="${isReversed ? 'transform: rotate(180deg);' : ''}">
          <div class="card-name">${card.name}</div>
          <div class="orientation">${isReversed ? 'Reversed' : 'Upright'}</div>
        `;
        container.appendChild(slot);
      });
      
      document.getElementById('ai-reading').innerHTML = reading.interpretation;
      document.getElementById('reading-title').textContent = `Past Reading: ${reading.spread}`;
      
      // Switch to reading tab
      switchTab('reading');
      document.getElementById('question-form').style.display = 'none';
      document.getElementById('reading-area').classList.add('active');
    }
    
    function saveReading(question, cards, spread, interpretation) {
      const history = JSON.parse(localStorage.getItem('readingHistory') || '[]');
      
      history.unshift({
        timestamp: new Date().toISOString(),
        question: question,
        cards: cards,
        spread: spread.name,
        interpretation: interpretation
      });
      
      // Keep last 50 readings
      if (history.length > 50) history.pop();
      
      localStorage.setItem('readingHistory', JSON.stringify(history));
    }
    
    function clearHistory() {
      if (confirm('Are you sure you want to clear your reading history?')) {
        localStorage.removeItem('readingHistory');
        loadHistory();
      }
    }
    
    // ========== INITIALIZATION ==========
    // Load encyclopedia on page load for instant display when tab is clicked
    async function initApp() {
      try {
        const response = await fetch(`${API_BASE}/cards`);
        const data = await response.json();
        allCards = data.cards || data;
      } catch (err) {
        console.error('Failed to preload cards:', err);
      }
    }
    
    initApp();
  </script>
</body>
</html>